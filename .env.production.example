APP_ENV=prod
FORCE_HTTPS=true

BROKER_BASE_URL=https://sso.yourdomain.com
BROKER_NAME=GrandpaSSOn

SESSION_COOKIE_NAME=AUTHSESSID
SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=480
READER_SESSION_COOKIE_NAME=GPSREADER

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_shared_db
DB_USER=u123456789_dbuser
DB_PASSWORD=YOUR_STRONG_HOSTINGER_DB_PASSWORD
DB_PREFIX=sso_

ALLOWED_EMAIL_DOMAINS=yourdomain.com

MIGRATE_TOKEN=GENERATE_RANDOM_SECURE_TOKEN_32_CHARS
CRON_TOKEN=GENERATE_RANDOM_SECURE_TOKEN_32_CHARS
ADMIN_API_TOKEN=GENERATE_RANDOM_SECURE_TOKEN_32_CHARS

ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_TTL_MAX_SECONDS=3600
AUDIT_RETENTION_DAYS=90

RATE_LIMIT_OAUTH_MAX=60
RATE_LIMIT_OAUTH_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900

JWT_ACCESS_TOKEN_ENABLED=false
JWT_HMAC_SECRET=
JWT_KEY_ENCRYPTION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sso.yourdomain.com/callback/google

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://sso.yourdomain.com/callback/github
